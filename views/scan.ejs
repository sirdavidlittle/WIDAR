<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>WIDAR :: Scan <%- scan.id %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/sim.css">
    <link rel="icon" href="/img/favicon.ico">
    <style>@import url('https://fonts.googleapis.com/css2?family=Quicksand:wght@600&display=swap');</style>
  </head>
  <body>
  <header>
    <div class="title widar">
      <span class="banner"> <img width="80px" src="/img/widar_small.jpg" alt="WiDAR Logo"> WiDAR</span>
      <p class="description">A Helpful handheld WiFi-Radar</p>
    </div>
    <!--break-->
    <nav class="condensed">
        <a href="/">Home</a>
    </nav>
  </header>
  <main>

  <section class="widar-area">
    <div class="widar-info">
      <p class="widar-title"> <%= scan.name%></p>
      <p class="widar-description"> <%= scan.description%></p>
      <div class="scan-dates">
        <span class="relative time"><%= formatTimeRelative(scan.time) %></span>
        <span class="absolute time"><%= formatTimeAbsolute(scan.time) %></span>
      </div>
    </div>

    <div class="sim-area">
    <canvas style="background-image:url(<%- previewImage(scan.id) %>);" width="500px" height="500px" class="sim-canvas" id="sim"></canvas>
    </div>
  </section>
  </main>

  <footer>WIDAR ® 2026</footer>

  <script src="/js/widar_sim.js"></script>
  </body>
</html>
