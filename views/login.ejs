<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>WIDAR :: Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/img/favicon.ico">
  </head>
  <body>
    <header>
      Login
      <% if (destination) { %>
        <% for (const item of destination) { %>
          <span class="arrow">&rarr;</span> <%= item%>
        <% } %>
      <% } %>

    </header>

    <% if (failed) {%>
      <h4> Login Failed </h4>
    <% } %>
    <main>
    <fieldset>
      <img src="/img/widar.jpg" width="64px">
      <legend>Login</legend>
      <form action="/login" method="POST">
        <input required type="text" name="username" placeholder="username"><br>
        <input required type="password" name="password" placeholder="password">
        <input type="submit">
      </form>
    </fieldset>
    </main>
    <footer>WIDAR ® 2026</footer>
  </body>
</html>
