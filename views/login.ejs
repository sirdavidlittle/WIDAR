<!DOCTYPE html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8">
    <title>WIDAR :: Login</title>
  </head>
  <body>
    <% if (failed) {%>
      <h4> Login Failed </h4>
    <%}%>
    <p>Login</p>
    <form action="/login" method="POST">
      <input type="text" name="username" placeholder="username">
      <input type="password" name="password" placeholder="password">
      <input type="submit">
    </form>
  </body>
</html>
